<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base background of the panel when gazed at -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#37474F" />
            <corners android:radius="16dp" />
            <stroke android:width="3dp" android:color="#80D8FF" />
        </shape>
    </item>
    <!-- Underline (subrayado) at the bottom in very light high contrast blue -->
    <item android:gravity="bottom" android:height="6dp" android:bottom="0dp" android:left="8dp" android:right="8dp">
        <shape android:shape="rectangle">
            <solid android:color="#00FFFF" />
            <corners android:radius="3dp" />
        </shape>
    </item>
</layer-list>
