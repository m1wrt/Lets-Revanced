<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/necesidadesBasicasLayoutRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/main_background"
    android:clickable="true"
    android:focusable="true">

    <!-- Guidelines for 2x3 Grid -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/necesidades_guideline_h"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.5" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/necesidades_guideline_v1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.333" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/necesidades_guideline_v2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.666" />

    <!-- 1. Top Left: Quiero comer algo (Gaze 6 - Arriba Izquierda) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/btn_necesidades_comer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/panel_background"
        android:padding="12dp"
        app:layout_constraintBottom_toTopOf="@+id/necesidades_guideline_h"
        app:layout_constraintEnd_toStartOf="@+id/necesidades_guideline_v1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/img_necesidades_1"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:elevation="8dp"
            android:src="@drawable/ic_gaze_arriba_izq"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/text_necesidades_1"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Quiero comer algo"
            android:textColor="@color/white"
            android:textSize="22sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/img_necesidades_1" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- 2. Top Middle: Quiero ir al baño (Gaze 4 - Arriba) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/btn_necesidades_bano"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/panel_background"
        android:padding="12dp"
        app:layout_constraintBottom_toTopOf="@+id/necesidades_guideline_h"
        app:layout_constraintEnd_toStartOf="@+id/necesidades_guideline_v2"
        app:layout_constraintStart_toEndOf="@+id/necesidades_guideline_v1"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/img_necesidades_2"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:elevation="8dp"
            android:src="@drawable/ic_gaze_arriba"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/text_necesidades_2"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Quiero ir al baño"
            android:textColor="@color/white"
            android:textSize="22sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/img_necesidades_2" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- 3. Top Right: Quiero beber agua (Gaze 7 - Arriba Derecha) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/btn_necesidades_agua"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/panel_background"
        android:padding="12dp"
        app:layout_constraintBottom_toTopOf="@+id/necesidades_guideline_h"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/necesidades_guideline_v2"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/img_necesidades_3"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:elevation="8dp"
            android:src="@drawable/ic_gaze_arriba_der"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/text_necesidades_3"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Quiero beber agua"
            android:textColor="@color/white"
            android:textSize="22sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/img_necesidades_3" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- 4. Bottom Left: Quiero descansar (Gaze 1 - Abajo Izquierda) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/btn_necesidades_descansar"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/panel_background"
        android:padding="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/necesidades_guideline_v1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/necesidades_guideline_h">

        <TextView
            android:id="@+id/text_necesidades_4"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginBottom="8dp"
            android:gravity="center"
            android:text="Quiero descansar"
            android:textColor="@color/white"
            android:textSize="22sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toTopOf="@+id/img_necesidades_4"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/img_necesidades_4"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginBottom="8dp"
            android:elevation="8dp"
            android:src="@drawable/ic_gaze_abajo_izq"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- 5. Bottom Middle: Quiero dormir (Gaze 5 - Guiño / Wink) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/btn_necesidades_dormir"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/panel_background"
        android:padding="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/necesidades_guideline_v2"
        app:layout_constraintStart_toEndOf="@+id/necesidades_guideline_v1"
        app:layout_constraintTop_toBottomOf="@+id/necesidades_guideline_h">

        <TextView
            android:id="@+id/text_necesidades_5"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginBottom="8dp"
            android:gravity="center"
            android:text="Quiero dormir"
            android:textColor="@color/white"
            android:textSize="22sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toTopOf="@+id/img_necesidades_5"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/img_necesidades_5"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginBottom="8dp"
            android:elevation="8dp"
            android:src="@drawable/ic_gaze_cerrado"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- 6. Bottom Right: REGRESAR (Gaze 2 - Abajo Derecha) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/btn_necesidades_regresar"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/panel_background"
        android:padding="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/necesidades_guideline_v2"
        app:layout_constraintTop_toBottomOf="@+id/necesidades_guideline_h">

        <TextView
            android:id="@+id/text_necesidades_6"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginBottom="8dp"
            android:gravity="center"
            android:text="REGRESAR"
            android:textColor="@color/white"
            android:textSize="22sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toTopOf="@+id/img_necesidades_6"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/img_necesidades_6"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginBottom="8dp"
            android:elevation="8dp"
            android:src="@drawable/ic_gaze_abajo_der"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
